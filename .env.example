# =================================================================
# MYWINGMAN PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# =================================================================
# Copy this file to .env and replace placeholders with production keys

PORT=3000
NODE_ENV=production

# API Gateway Credentials (AICREDITS / OpenRouter)
AICREDITS_BASE_URL="https://api.aicredits.in/v1"
AICREDITS_MODEL="qwen/qwen3-235b-a22b-2507"
AICREDITS_API_KEY="your_general_api_key_here"
AICREDITS_API_KEY_GENERAL="your_general_api_key_here"
AICREDITS_API_KEY_VISION="your_vision_api_key_here"

# Security & CORS Settings
# Note: Authentication is handled via Supabase Auth (SUPABASE_URL and SUPABASE_ANON_KEY).
# Production: explicit HTTPS origins only. Localhost is automatically allowed in non-production.
ALLOWED_ORIGINS="https://mywingman.com,https://chimerical-granita-c68c5a.netlify.app"
JWT_SECRET="optional_legacy_secret"

# Supabase Authentication & Database Integration (3-Tier Postgres)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"
SUPABASE_JWT_SECRET="optional_supabase_jwt_secret_for_local_verification"

# Railway Backend API Public Gateway URL
RAILWAY_STATIC_URL="https://your-backend.up.railway.app"

# Local Development & Testing Flags (Set NODE_ENV=development)
# ENABLE_MOCK_AUTH=true
