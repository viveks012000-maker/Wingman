# =================================================================
# MYWINGMAN PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# =================================================================
# Copy this file to .env and replace placeholders with production keys

PORT=3000
NODE_ENV=production

# API Gateway Credentials (AICREDITS / OpenRouter)
AICREDITS_BASE_URL="https://api.aicredits.in/v1"
AICREDITS_MODEL="qwen/qwen3-235b-a22b-2507"
AICREDITS_API_KEY="your_general_api_key_here"
AICREDITS_API_KEY_GENERAL="your_general_api_key_here"
AICREDITS_API_KEY_VISION="your_vision_api_key_here"
# Optional last-resort fallback key for the Maeve chat provider failover chain
# (server.js queryOpenRouter). Used only when all AICREDITS keys fail over.
OPENROUTER_API_KEY="your_optional_openrouter_key_here"

# Security & CORS Settings
# Note: Authentication is handled via Supabase Auth (SUPABASE_URL and SUPABASE_ANON_KEY).
# Production: explicit HTTPS origins only. Localhost is automatically allowed in non-production.
ALLOWED_ORIGINS="https://mywingmanapp.com"

# Razorpay: disabled by default. Test credentials must only be used against an
# isolated Test Mode database outside production. Never copy test keys to Railway.
RAZORPAY_PAYMENTS_ENABLED=false
RAZORPAY_SCHEMA_READY=false
RAZORPAY_MODE=disabled
RAZORPAY_RECONCILIATION_SCHEMA_READY=false
# Isolated Test Mode only (legacy RAZORPAY_KEY_* aliases remain supported).
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_TEST_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Live activation is separately gated and requires provider eligibility, owner
# approval, migration replay, verified live checkout and a configured live webhook.
# Keep all flags false and all values blank until every release gate is verified.
RAZORPAY_LIVE_PRECHECKS_PASSED=false
RAZORPAY_LIVE_TAX_APPROVED=false
RAZORPAY_LIVE_ACCOUNT_ID=
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_LIVE_WEBHOOK_SECRET=
RAZORPAY_LIVE_WEBHOOK_CONFIGURED=false
RAZORPAY_LIVE_INR_ELIGIBLE=false
RAZORPAY_LIVE_INR_APPROVED=false
RAZORPAY_LIVE_VIP_APPROVED=false
RAZORPAY_LIVE_USD_ELIGIBLE=false
RAZORPAY_LIVE_USD_APPROVED=false
# Fixed provider minor-unit amounts, not indicative exchange-rate estimates.
RAZORPAY_LIVE_USD_PRICES_JSON=
# Supabase Authentication & Database Integration (3-Tier Postgres)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# Railway Backend API Public Gateway URL
RAILWAY_STATIC_URL="https://your-backend.up.railway.app"

# Local Development & Testing Flags (Set NODE_ENV=development)
# ENABLE_MOCK_AUTH=true
